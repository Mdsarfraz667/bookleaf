{
  "info": {
    "name": "BookLeaf Author Support Portal",
    "description": "Login saves {{token}} to the active environment; every other request sends it as a Bearer token. Set {{baseUrl}} (default http://localhost:4000), {{authorEmail}}, {{adminEmail}}, and {{password}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "authorEmail", "value": "priya.sharma@email.com" },
    { "key": "adminEmail", "value": "ops@bookleaf.com" },
    { "key": "password", "value": "Bookleaf@123" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "Meta (enums)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/meta" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Author (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);",
                  "if (pm.environment && pm.environment.set) pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authorEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Admin (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "if (pm.environment && pm.environment.set) pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Author",
      "item": [
        {
          "name": "My Books",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Create Ticket (saves ticketId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('ticketId', json.ticket.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"No royalty in 6 months\",\n  \"description\": \"I have not received any royalty payment.\"\n}"
            },
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "My Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Ticket Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Reply on Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Any update please?\"\n}" },
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/messages"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Ticket Queue (urgent)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tickets?sort=urgent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tickets"],
              "query": [{ "key": "sort", "value": "urgent" }]
            }
          }
        },
        {
          "name": "Ticket Detail (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Generate/Cache Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/tickets/{{ticketId}}/draft"
          }
        },
        {
          "name": "Respond",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Thanks for flagging this \u2014 we are escalating. \u2014 The BookLeaf Team\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/tickets/{{ticketId}}/respond"
          }
        },
        {
          "name": "Override (priority/category/assign)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"CRITICAL\",\n  \"assignToMe\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Internal Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Payout was stuck in finance system.\"\n}" },
            "url": "{{baseUrl}}/api/admin/tickets/{{ticketId}}/notes"
          }
        }
      ]
    }
  ]
}
