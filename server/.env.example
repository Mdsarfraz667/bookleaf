# HTTP
PORT=4000
NODE_ENV=development
# Browser origin allowed by CORS. Comma-separate extra origins if needed later.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public

# Stateless JWT. Use a long random value outside local development.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared password for seeded authors and the ops admin. The dataset has no passwords.
SEED_PASSWORD=Bookleaf@123

# Server-only. Never expose this to the client bundle.
ANTHROPIC_API_KEY=
# Must stay claude-haiku-4-5.
AI_MODEL=claude-haiku-4-5
# Set to false to run the whole app with zero AI calls.
AI_ENABLED=true
